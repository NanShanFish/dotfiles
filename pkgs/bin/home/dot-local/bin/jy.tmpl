#!/bin/bash
# vim: set filetype=bash:

org_dir="@@doc_dir@@"/org

verify() {
    if ! test -d "$org_dir"; then
        exit 1
    fi
    if ! which ndate &> /dev/null; then
        exit 1
    fi
}

create-file(){
    cd $org_dir
    if [[ ! -e "$1" ]]; then
        daily_dir=$(dirname $1)
        if [[ ! -d "$daily_dir" ]]; then
            mkdir -p "$daily_dir"
        fi
        touch "$1"
    fi
    if [ -z "$2" ]; then
        nvim $1
    else
        echo $1
    fi
}

open() {
    if [ "$1" = "todo" ]; then
        f="gtd.org"
        nvim "$org_dir/$f"
        return
    elif [ -z "$1" ]; then
        f="$(date "+journal/%Y/%m/%Y-%m-%d.org")"
    else
        f="$(ndate "$1" -f "journal/%Y/%m/%Y-%m-%d.org")"
    fi

    create-file $f $2
}

helpfunc() {
    echo "NAME"
    echo -e "\tjy - Open the diary for a specified date\n"
    echo "OPTIONS"
    echo -e "\tjy"
    echo -e "\t\tOpen today diary\n"
    echo -e "\tjy [relative date]"
    echo -e "\t\tOpen the diary relative to today.\n\t\tE.g., jy -3 (3 days ago), jy 3 (3 days later)\n"
    echo -e "\tjy [MM-DD]"
    echo -e "\t\tOpen the diary for the nearest occurrence of that day.\n\t\tE.g., jy 09-05\n"
    echo -e "\tjy [YYYY-MM-DD]"
    echo -e "\t\tOpen the diary for the specified date.\n\t\tE.g., jy 24-11-03\n"
}

verify $1
open $1 $2
